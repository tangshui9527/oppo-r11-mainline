# USB configfs & NCM gadget for early network access
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# Early Framebuffer
CONFIG_FB_SIMPLE=y
CONFIG_DRM_SIMPLEDRM=y

# Devtmpfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Storage & filesystems
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y

# Debugging
CONFIG_DEBUG_KERNEL=y
CONFIG_SERIAL_MSM_GENI=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
