+	/*
+	 * Keep proxy power-domain votes (cx/mx) after handover: the WLAN PD
+	 * hosted in the modem requires the CX/MX rails to stay at boot voltage
+	 * once the radio is active; dropping the votes trips the Hexagon
+	 * watchdog ~12-16s after association on SDM660.
+	 */
+	if (!qproc->keep_proxy_pds)
+		q6v5_pds_disable(qproc, qproc->proxy_pds, qproc->proxy_pd_count);
