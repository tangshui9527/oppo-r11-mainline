			qcom,smem-states = <0x30 0x00>;
			qcom,smem-state-names = "stop";
			resets = <0x25 0x09>;
			reset-names = "mss_restart";
			qcom,halt-regs = <0x31 0x3000 0x5000 0x4000>;
			power-domains = <0x32 0x00 0x32 0x03>;
			power-domain-names = "cx", "mx";
			memory-region = <0x33 0x34 0x35>;
			status = "okay";
			firmware-name = "mba.mbn", "modem.mdt";
			phandle = <0x2e>;

			glink-edge {
				interrupts = <0x00 0x1c4 0x01>;
				label = "modem";
				qcom,remote-pid = <0x01>;
				mboxes = <0x1a 0x0f>;
			};
		};

		gpu@5000000 {
			compatible = "qcom,adreno-512.0", "qcom,adreno";
			reg = <0x5000000 0x40000>;
			reg-names = "kgsl_3d0_reg_memory";
			interrupts = <0x00 0x12c 0x04>;
			clocks = <0x25 0x37 0x36 0x08 0x25 0x16 0x25 0x36 0x36 0x06 0x36 0x07>;
			clock-names = "iface", "rbbmtimer", "mem", "mem_iface", "rbcpr", "core";
			power-domains = <0x32 0x03>;
			iommus = <0x37 0x00>;
			nvmem-cells = <0x38>;
			nvmem-cell-names = "speed_bin";
			interconnects = <0x2a 0x01 0x2a 0x05>;
			interconnect-names = "gfx-mem";
			operating-points-v2 = <0x39>;
			#cooling-cells = <0x02>;
			status = "okay";
			phandle = <0xa8>;

			opp-table {
				compatible = "operating-points-v2";
				phandle = <0x39>;

				opp-588000000 {
					opp-hz = <0x00 0x230c2b00>;
					opp-level = <0x100>;
					opp-peak-kBps = <0x2ee000>;
					opp-supported-hw = <0x70>;
				};

				opp-465000000 {
					opp-hz = <0x00 0x1bb75640>;
					opp-level = <0xc0>;
					opp-peak-kBps = <0x2990a0>;
					opp-supported-hw = <0x78>;
				};

				opp-370000000 {
					opp-hz = <0x00 0x160dc080>;
					opp-level = <0x80>;
					opp-peak-kBps = <0x2162e0>;
					opp-supported-hw = <0xff>;
				};

				opp-160000000 {
					opp-hz = <0x00 0x9896800>;
					opp-level = <0x30>;
					opp-peak-kBps = <0x124f80>;
					opp-supported-hw = <0xff>;
				};

				opp-19200000 {
					opp-hz = <0x00 0x124f800>;
					opp-level = <0x30>;
					opp-peak-kBps = <0x124f80>;
					opp-supported-hw = <0xff>;
				};

				opp-430000000 {
					opp-hz = <0x00 0x19a14780>;
					opp-level = <0xc0>;
					opp-peak-kBps = <0x2990a0>;
					opp-supported-hw = <0x04>;
				};

				opp-266000000 {
					opp-hz = <0x00 0xfdad680>;
					opp-level = <0x40>;
					opp-peak-kBps = <0x192580>;
					opp-supported-hw = <0xff>;
				};
			};

			zap-shader {
				memory-region = <0x3a>;
				firmware-name = "a512_zap.mbn";
			};
		};

		iommu@5040000 {
			compatible = "qcom,sdm630-smmu-v2", "qcom,adreno-smmu", "qcom,smmu-v2";
			reg = <0x5040000 0x10000>;
			power-domains = <0x36 0x01>;
			clocks = <0x25 0x37 0x25 0x16 0x25 0x36>;
			clock-names = "iface", "mem", "mem_iface";
			#global-interrupts = <0x02>;
			#iommu-cells = <0x01>;
			interrupts = <0x00 0xe5 0x04 0x00 0xe7 0x04 0x00 0x149 0x04 0x00 0x14a 0x04 0x00 0x14b 0x04 0x00 0x14c 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x15d 0x04 0x00 0x15e 0x04>;
			phandle = <0x37>;
		};

		clock-controller@5065000 {
			compatible = "qcom,gpucc-sdm660";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			reg = <0x5065000 0x9038>;
			clocks = <0x23 0x25 0x38 0x25 0x39>;
			clock-names = "xo", "gcc_gpu_gpll0_clk", "gcc_gpu_gpll0_div_clk";
			phandle = <0x36>;
		};

		iommu@5100000 {
			compatible = "qcom,sdm630-smmu-v2", "qcom,smmu-v2";
			reg = <0x5100000 0x40000>;
			#iommu-cells = <0x01>;
			clocks = <0x25 0x83>;
			clock-names = "bus";
			power-domains = <0x25 0x05>;
			#global-interrupts = <0x02>;
			interrupts = <0x00 0xe5 0x04 0x00 0xe7 0x04 0x00 0xe2 0x04 0x00 0x189 0x04 0x00 0x18a 0x04 0x00 0x18b 0x04 0x00 0x18c 0x04 0x00 0x18d 0x04 0x00 0x18e 0x04 0x00 0x18f 0x04 0x00 0x190 0x04 0x00 0x191 0x04 0x00 0x192 0x04 0x00 0x193 0x04 0x00 0x89 0x04 0x00 0xe0 0x04 0x00 0xe1 0x04 0x00 0x136 0x04 0x00 0x194 0x04>;
			phandle = <0x94>;
		};

		sram@290000 {
			compatible = "qcom,rpm-stats";
			reg = <0x290000 0x10000>;
		};

		spmi@800f000 {
			compatible = "qcom,spmi-pmic-arb";
			reg = <0x800f000 0x1000 0x8400000 0x1000000 0x9400000 0x1000000 0xa400000 0x220000 0x800a000 0x3000>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			interrupt-names = "periph_irq";
			interrupts = <0x00 0x146 0x04>;
			qcom,ee = <0x00>;
			qcom,channel = <0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pmic@0 {
				compatible = "qcom,pm660", "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				rtc@6000 {
					compatible = "qcom,pm8941-rtc";
					reg = <0x6000 0x6100>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x61 0x01 0x01>;
				};

				pon@800 {
					compatible = "qcom,pm8998-pon";
					reg = <0x800>;
					mode-bootloader = <0x02>;
					mode-recovery = <0x01>;

					pwrkey {
						compatible = "qcom,pm8941-pwrkey";
						interrupts = <0x00 0x08 0x00 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						linux,code = <0x74>;
						status = "okay";
					};

					resin {
						compatible = "qcom,pm8941-resin";
						interrupts = <0x00 0x08 0x01 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						status = "okay";
						linux,code = <0x72>;
					};
				};

				charger@1000 {
					compatible = "qcom,pm660-charger";
					reg = <0x1000>;
					interrupts = <0x00 0x13 0x04 0x03 0x00 0x12 0x02 0x03 0x00 0x16 0x01 0x01 0x00 0x13 0x06 0x01>;
					interrupt-names = "usb-plugin", "bat-ov", "wdog-bark", "usbin-icl-change";
					io-channels = <0x3b 0x03 0x3b 0x04>;
					io-channel-names = "usbin_i", "usbin_v";
					/* Disabled like the reference build: the PM660 charger IC
					 * charges autonomously with stock-safe defaults; the
					 * mainline qcom_smbx driver wedges at status=Full with no
					 * input current and actively stops charging. */
					status = "disabled";
					monitored-battery = <0x3c>;
					phandle = <0x3e>;
				};

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x00 0x24 0x00 0x01>;
					io-channels = <0x3d 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					phandle = <0xa9>;
				};

				adc@3100 {
					compatible = "qcom,spmi-adc-rev2";
					reg = <0x3100>;
					interrupts = <0x00 0x31 0x00 0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#io-channel-cells = <0x01>;
					phandle = <0x3d>;

					channel@0 {
						reg = <0x00>;
						qcom,decimation = <0x400>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "ref_gnd";
					};

					channel@1 {
						reg = <0x01>;
						qcom,decimation = <0x400>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "vref_1p25";
					};

					channel@6 {
						reg = <0x06>;
						qcom,decimation = <0x400>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "die_temp";
					};

					channel@4c {
						reg = <0x4c>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,decimation = <0x400>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						label = "xo_therm";
					};

					channel@4d {
						reg = <0x4d>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,decimation = <0x400>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						label = "msm_therm";
					};

					channel@4e {
						reg = <0x4e>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,decimation = <0x400>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						label = "emmc_therm";
					};

					channel@4f {
						reg = <0x4f>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,decimation = <0x400>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						label = "pa_therm0";
					};

					channel@50 {
						reg = <0x50>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,decimation = <0x400>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						label = "pa_therm1";
					};

					channel@51 {
						reg = <0x51>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,decimation = <0x400>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						label = "quiet_therm";
					};

					channel@83 {
						reg = <0x83>;
						qcom,decimation = <0x400>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vph_pwr";
					};

					channel@85 {
						reg = <0x85>;
						qcom,decimation = <0x400>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vcoin";
					};
				};

				battery@4000 {
					compatible = "qcom,pmi8998-fg";
					reg = <0x4000>;
					interrupts = <0x00 0x40 0x03 0x01>;
					interrupt-names = "soc-delta";
					status = "disabled";
					monitored-battery = <0x3c>;
					power-supplies = <0x3e>;
				};

				adc@4500 {
					compatible = "qcom,pm660-rradc";
					reg = <0x4500>;
					#io-channel-cells = <0x01>;
					status = "okay";
					phandle = <0x3b>;
				};

				gpio@c000 {
					compatible = "qcom,pm660-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					gpio-ranges = <0x3f 0x00 0x00 0x0d>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x3f>;
				};

				usb-vbus-regulator@1500 {
					compatible = "qcom,pm660-vbus-reg";
					reg = <0x1500>;
					regulator-name = "usb_otg_vbus";
					regulator-min-microamp = <0x7a120>;
					regulator-max-microamp = <0x7a120>;
					phandle = <0x42>;
				};
			};

			pmic@1 {
				compatible = "qcom,pm660", "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				vibrator@c000 {
					compatible = "qcom,pmi8998-haptics", "qcom,spmi-haptics";
					reg = <0xc000>;
					interrupts = <0x01 0xc0 0x00 0x03 0x01 0xc0 0x01 0x03>;
					interrupt-names = "short", "play";
					qcom,actuator-type = <0x00>;
					qcom,brake-pattern = <0x03 0x03 0x00 0x00>;
					qcom,play-mode = <0x01>;
					qcom,wave-play-rate-us = <0x1a0b>;
					qcom,wave-shape = <0x01>;
					status = "okay";
				};

				regulators {
					compatible = "qcom,pm660-regulators";
				};
			};

			pmic@2 {
				compatible = "qcom,pm660l", "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x02 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0xaa>;
				};

				gpio@c000 {
					compatible = "qcom,pm660l-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					gpio-ranges = <0x40 0x00 0x00 0x0c>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x40>;

					vol-up-default-state {
						pins = "gpio7";
						function = "normal";
						bias-pull-up;
						input-enable;
						qcom,drive-strength = <0x00>;
					};

					r11t-volume-keys-default-state {
						pins = "gpio5", "gpio8";
						function = "normal";
						bias-pull-up;
						input-enable;
						qcom,drive-strength = <0x00>;
						phandle = <0xab>;
					};
				};
			};

			pmic@3 {
				compatible = "qcom,pm660l", "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pwm {
					compatible = "qcom,pm660l-lpg";
					status = "okay";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					qcom,power-source = <0x01>;

					led@1 {
						reg = <0x01>;
						color = <0x00>;
						function = "status";
						default-state = "off";
					};
				};

				led-controller@d300 {
					compatible = "qcom,pm660l-flash-led", "qcom,spmi-flash-led";
					reg = <0xd300>;
					status = "okay";

					led-0 {
						function = "flash";
						color = <0x00>;
						led-sources = <0x01>;
						led-max-microamp = <0x186a0>;
						flash-max-microamp = <0xb71b0>;
						flash-max-timeout-us = <0x138800>;
					};
				};

				leds@d800 {
					compatible = "qcom,pm660l-wled";
					reg = <0xd800 0xd900>;
					interrupts = <0x03 0xd8 0x01 0x01 0x03 0xd8 0x02 0x01>;
					interrupt-names = "ovp", "short";
					label = "backlight";
					status = "okay";
					qcom,switching-freq = <0x320>;
					qcom,current-limit-microamp = <0x4e20>;
					qcom,num-strings = <0x02>;
				};

				audio-codec@f000 {
					compatible = "qcom,pm8916-wcd-analog-codec";
					reg = <0xf000>;
					interrupts = <0x03 0xf0 0x00 0x00 0x03 0xf0 0x01 0x00 0x03 0xf0 0x02 0x00 0x03 0xf0 0x03 0x00 0x03 0xf0 0x04 0x00 0x03 0xf0 0x05 0x00 0x03 0xf0 0x06 0x00 0x03 0xf0 0x07 0x00 0x03 0xf1 0x00 0x00 0x03 0xf1 0x01 0x00 0x03 0xf1 0x02 0x00 0x03 0xf1 0x03 0x00 0x03 0xf1 0x04 0x00 0x03 0xf1 0x05 0x00>;
					interrupt-names = "cdc_spk_cnp_int", "cdc_spk_clip_int", "cdc_spk_ocp_int", "mbhc_ins_rem_det1", "mbhc_but_rel_det", "mbhc_but_press_det", "mbhc_ins_rem_det", "mbhc_switch_int", "cdc_ear_ocp_int", "cdc_hphr_ocp_int", "cdc_hphl_ocp_det", "cdc_ear_cnp_int", "cdc_hphr_cnp_int", "cdc_hphl_cnp_int";
					qcom,hphl-jack-type-normally-open;
					qcom,gnd-jack-type-normally-open;
					qcom,mbhc-vthreshold-low = <0x3c 0x83 0xfd 0x1a9 0x1aa>;
					qcom,mbhc-vthreshold-high = <0x82 0x83 0xfd 0x1a9 0x1aa>;
					qcom,micbias2-ext-cap;
					#sound-dai-cells = <0x01>;
					status = "okay";
					vdd-cdc-io-supply = <0x20>;
					vdd-cdc-tx-rx-cx-supply = <0x20>;
					vdd-micbias-supply = <0x20>;
					qcom,micbias-lvl = <0xa8c>;
					qcom,mbhc-external-micbias;
					phandle = <0xa4>;
				};

				regulators {
					compatible = "qcom,pm660l-regulators";
				};

				oledb@e000 {
					compatible = "qcom,qpnp-oledb-regulator";
					reg = <0xe000>;
					regulator-name = "oledb";
					regulator-min-microvolt = <0x4c4b40>;
					regulator-max-microvolt = <0x7b98a0>;
					qcom,swire-control;
					qcom,ext-pin-control;
					phandle = <0x61>;
				};
			};
		};

		usb@a8f8800 {
			compatible = "qcom,sdm660-dwc3", "qcom,dwc3";
			reg = <0xa8f8800 0x400>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			clocks = <0x25 0x31 0x25 0x5b 0x25 0x15 0x25 0x5d 0x25 0x5c>;
			clock-names = "cfg_noc", "core", "iface", "sleep", "mock_utmi";
			assigned-clocks = <0x25 0x5c 0x25 0x5b>;
			assigned-clock-rates = <0x124f800 0x7270e00>;
			interrupts = <0x00 0xb4 0x04 0x00 0x15b 0x04 0x00 0x85 0x04 0x00 0xf3 0x04>;
			interrupt-names = "pwr_event", "qusb2_phy", "hs_phy_irq", "ss_phy_irq";
			power-domains = <0x25 0x02>;
			resets = <0x25 0x07>;
			qcom,select-utmi-as-pipe-clk;

			usb@a800000 {
				compatible = "snps,dwc3";
				reg = <0xa800000 0xc8d0>;
				interrupts = <0x00 0x83 0x04>;
				snps,dis_u2_susphy_quirk;
				snps,dis_enblslpm_quirk;
				snps,parkmode-disable-ss-quirk;
				snps,dis-u1-entry-quirk;
				snps,dis-u2-entry-quirk;
				phys = <0x41>;
				phy-names = "usb2-phy";
				snps,hird-threshold = [00];
				maximum-speed = "high-speed";
				dr_mode = "otg";
				usb-role-switch;
				role-switch-default-mode = "peripheral";
				vbus-supply = <0x42>;
			};
		};

		phy@c010000 {
			compatible = "qcom,sdm660-qmp-usb3-phy";
			reg = <0xc010000 0x1000>;
			clocks = <0x25 0x5f 0x25 0x5e 0x25 0x61 0x25 0x60>;
			clock-names = "aux", "ref", "cfg_ahb", "pipe";
			clock-output-names = "usb3_phy_pipe_clk_src";
			#clock-cells = <0x00>;
			#phy-cells = <0x00>;
			resets = <0x25 0x04 0x25 0x05>;
			reset-names = "phy", "phy_phy";
			qcom,tcsr-reg = <0x31 0x6b244>;
			status = "disabled";
		};

		phy@c012000 {
			compatible = "qcom,sdm660-qusb2-phy";
			reg = <0xc012000 0x180>;
			#phy-cells = <0x00>;
			clocks = <0x25 0x61 0x25 0x81>;
			clock-names = "cfg_ahb", "ref";
			resets = <0x25 0x00>;
			nvmem-cells = <0x43>;
			status = "okay";
			vdd-supply = <0x44>;
			vdda-pll-supply = <0x45>;
			vdda-phy-dpdm-supply = <0x46>;
			phandle = <0x41>;
		};

		phy@c014000 {
			compatible = "qcom,sdm660-qusb2-phy";
			reg = <0xc014000 0x180>;
			#phy-cells = <0x00>;
			clocks = <0x25 0x61 0x25 0x82>;
			clock-names = "cfg_ahb", "ref";
			resets = <0x25 0x01>;
			nvmem-cells = <0x43>;
			status = "disabled";
			phandle = <0x51>;
		};

		mmc@c084000 {
			compatible = "qcom,sdm630-sdhci", "qcom,sdhci-msm-v5";
			reg = <0xc084000 0x1000>;
			reg-names = "hc";
			interrupts = <0x00 0x7d 0x04 0x00 0xdd 0x04>;
			interrupt-names = "hc_irq", "pwr_irq";
