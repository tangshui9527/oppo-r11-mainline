/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "OPPO R11T";
	compatible = "oppo,r11t", "qcom,sdm660";
	chassis-type = "handset";
	qcom,msm-id = <0x13d 0x00>;
	qcom,board-id = <0x08 0x00 0x3eb3>;
	qcom,pmic-id = <0x1001b 0x1011a 0x00 0x00 0x1001b 0x2001a 0x00 0x00 0x1001b 0x202001a 0x00 0x00>;

	aliases {
		mmc1 = "/soc@0/mmc@c0c4000";
		mmc2 = "/soc@0/mmc@c084000";
		serial0 = "/soc@0/serial@c170000";
		serial1 = "/soc@0/serial@c1af000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:115200n8";
	};

	clocks {

		int-cdc-bclk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x177000>;
			clock-output-names = "int_cdc_bclk";
			phandle = <0x8f>;
		};

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			clock-output-names = "xo_board";
			phandle = <0x23>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			clock-output-names = "sleep_clk";
			phandle = <0x24>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x02 0x03 0x04 0x05 0x06>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x07>;
			phandle = <0x12>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x07>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x101>;
			enable-method = "psci";
			cpu-idle-states = <0x02 0x03 0x04 0x05 0x06>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x07>;
			phandle = <0x13>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x102>;
			enable-method = "psci";
			cpu-idle-states = <0x02 0x03 0x04 0x05 0x06>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x07>;
			phandle = <0x14>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x103>;
			enable-method = "psci";
			cpu-idle-states = <0x02 0x03 0x04 0x05 0x06>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x07>;
			phandle = <0x15>;
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09 0x0a 0x0b 0x0c>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0d>;
			phandle = <0x0e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x0d>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09 0x0a 0x0b 0x0c>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0d>;
			phandle = <0x0f>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09 0x0a 0x0b 0x0c>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0d>;
			phandle = <0x10>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x03>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09 0x0a 0x0b 0x0c>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0d>;
			phandle = <0x11>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};

				core2 {
					cpu = <0x10>;
				};

				core3 {
					cpu = <0x11>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x12>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};

				core3 {
					cpu = <0x15>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-retention";
				arm,psci-suspend-param = <0x40000002>;
				entry-latency-us = <0x152>;
				exit-latency-us = <0x1a7>;
				min-residency-us = <0xc8>;
				phandle = <0x08>;
			};

			cpu-sleep-0-1 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x203>;
				exit-latency-us = <0x71d>;
				min-residency-us = <0x3e8>;
				local-timer-stop;
				phandle = <0x09>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-retention";
				arm,psci-suspend-param = <0x40000002>;
				entry-latency-us = <0x9a>;
				exit-latency-us = <0x57>;
				min-residency-us = <0xc8>;
				phandle = <0x02>;
			};

			cpu-sleep-1-1 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x106>;
				exit-latency-us = <0x12d>;
				min-residency-us = <0x3e8>;
				local-timer-stop;
				phandle = <0x03>;
			};

			cluster-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-cluster-dynamic-retention";
				arm,psci-suspend-param = <0x400000f2>;
				entry-latency-us = <0x11c>;
				exit-latency-us = <0x180>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x0a>;
			};

			cluster-sleep-0-1 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-cluster-retention";
				arm,psci-suspend-param = <0x400000f3>;
				entry-latency-us = <0x152>;
				exit-latency-us = <0x1a7>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x0b>;
			};

			cluster-sleep-0-2 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-cluster-retention";
				arm,psci-suspend-param = <0x400000f4>;
				entry-latency-us = <0x203>;
				exit-latency-us = <0x71d>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x0c>;
			};

			cluster-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-cluster-dynamic-retention";
				arm,psci-suspend-param = <0x400000f2>;
				entry-latency-us = <0x110>;
				exit-latency-us = <0x149>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x04>;
			};

			cluster-sleep-1-1 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-cluster-retention";
				arm,psci-suspend-param = <0x400000f3>;
				entry-latency-us = <0x14c>;
				exit-latency-us = <0x170>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x05>;
			};

			cluster-sleep-1-2 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-cluster-retention";
				arm,psci-suspend-param = <0x400000f4>;
				entry-latency-us = <0x221>;
				exit-latency-us = <0x649>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x06>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-msm8998", "qcom,scm";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	opp-table-dsi {
		compatible = "operating-points-v2";
		phandle = <0x5b>;

		opp-131250000 {
			opp-hz = <0x00 0x7d2b750>;
			required-opps = <0x16>;
		};

		opp-210000000 {
			opp-hz = <0x00 0xc845880>;
			required-opps = <0x17>;
		};

		opp-262500000 {
			opp-hz = <0x00 0xfa56ea0>;
			required-opps = <0x18>;
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x06 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	remoteproc {
		compatible = "qcom,sdm660-rpm-proc", "qcom,rpm-proc";

		glink-edge {
			compatible = "qcom,glink-rpm";
			interrupts = <0x00 0xa8 0x01>;
			qcom,rpm-msg-ram = <0x19>;
			mboxes = <0x1a 0x00>;

			rpm-requests {
				compatible = "qcom,rpm-sdm660", "qcom,glink-smd-rpm";
				qcom,glink-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-sdm660", "qcom,rpmcc";
					#clock-cells = <0x01>;
					phandle = <0x26>;
				};

				power-controller {
					compatible = "qcom,sdm660-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x1b>;
					phandle = <0x32>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x1b>;

						opp1 {
							opp-level = <0x10>;
						};

						opp2 {
							opp-level = <0x20>;
						};

						opp3 {
							opp-level = <0x30>;
						};

						opp4 {
							opp-level = <0x40>;
							phandle = <0x4b>;
						};

						opp5 {
							opp-level = <0x80>;
							phandle = <0x16>;
						};

						opp6 {
							opp-level = <0xc0>;
							phandle = <0x17>;
						};

						opp7 {
							opp-level = <0x100>;
							phandle = <0x18>;
						};

						opp8 {
							opp-level = <0x140>;
						};

						opp9 {
							opp-level = <0x180>;
							phandle = <0x5a>;
						};
					};
				};

				regulators-0 {
					compatible = "qcom,rpm-pm660l-regulators";
					vdd_s1-supply = <0x1c>;
					vdd_s2-supply = <0x1c>;
					vdd_s3_s4-supply = <0x1c>;
					vdd_s5-supply = <0x1c>;
					vdd_s6-supply = <0x1c>;
					vdd_l1_l9_l10-supply = <0x1d>;
					vdd_l2-supply = <0x1e>;
					vdd_l3_l5_l7_l8-supply = <0x1e>;
					vdd_l4_l6-supply = <0x1e>;
					vdd_bob-supply = <0x1c>;

					bob {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x36ee80>;
						regulator-enable-ramp-delay = <0x1f4>;
						phandle = <0x1e>;
					};

					s1 {
						regulator-min-microvolt = <0x112a88>;
						regulator-max-microvolt = <0x112a88>;
						regulator-enable-ramp-delay = <0xc8>;
					};

					s2 {
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
						regulator-enable-ramp-delay = <0xc8>;
						phandle = <0x1d>;
					};

					l1 {
						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = <0xe1d48>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						phandle = <0x44>;
					};

					l2 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x292340>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
					};

					l3 {
						regulator-min-microvolt = <0x19f0a0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						regulator-always-on;
					};

					l4 {
						regulator-min-microvolt = <0x2cec00>;
						regulator-max-microvolt = <0x2d0b40>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-min-microamp = <0xc8>;
						regulator-max-microamp = <0x927c0>;
						regulator-system-load = <0x8b290>;
						regulator-allow-set-load;
						phandle = <0x4f>;
					};

					l5 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x32c800>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						regulator-system-load = "", "\f5";
					};

					l7 {
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2faf08>;
						regulator-enable-ramp-delay = <0xfa>;
						phandle = <0x46>;
					};

					l8 {
						regulator-min-microvolt = <0x30d400>;
						regulator-max-microvolt = <0x33e140>;
						regulator-enable-ramp-delay = <0xfa>;
					};

					l6 {
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-system-load = <0x3390>;
						regulator-allow-set-load;
						phandle = <0x60>;
					};
				};

				regulators-1 {
					compatible = "qcom,rpm-pm660-regulators";
					vdd_s1-supply = <0x1c>;
					vdd_s2-supply = <0x1c>;
					vdd_s3-supply = <0x1c>;
					vdd_s4-supply = <0x1c>;
					vdd_s5-supply = <0x1c>;
					vdd_s6-supply = <0x1c>;
					vdd_l1_l6_l7-supply = <0x1f>;
					vdd_l2_l3-supply = <0x1d>;
					vdd_l5-supply = <0x1d>;
					vdd_l8_l9_l10_l11_l12_l13_l14-supply = <0x20>;
					vdd_l15_l16_l17_l18_l19-supply = <0x1e>;

					s4 {
						regulator-min-microvolt = <0x1b8ac8>;
						regulator-max-microvolt = <0x1f20c0>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-always-on;
						phandle = <0x20>;
					};

					s5 {
						regulator-min-microvolt = <0x12ad40>;
						regulator-max-microvolt = <0x149970>;
						regulator-enable-ramp-delay = <0xc8>;
						phandle = <0x1f>;
					};

					s6 {
						regulator-min-microvolt = <0x7b0c0>;
						regulator-max-microvolt = <0xf2300>;
						regulator-enable-ramp-delay = <0x96>;
					};

					l1 {
						regulator-min-microvolt = <0x118c30>;
						regulator-max-microvolt = <0x1312d0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						phandle = <0x5c>;
					};

					l2 {
						regulator-min-microvolt = <0xe7ef0>;
						regulator-max-microvolt = <0xf6950>;
						regulator-enable-ramp-delay = <0xfa>;
					};

					l3 {
						regulator-min-microvolt = <0xe7ef0>;
						regulator-max-microvolt = <0xf6950>;
						regulator-enable-ramp-delay = <0xfa>;
					};

					l5 {
						regulator-min-microvolt = <0x802c8>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-enable-ramp-delay = <0xfa>;
						phandle = <0x96>;
					};

					l6 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x14e790>;
						regulator-allow-set-load;
						regulator-enable-ramp-delay = <0xfa>;
						phandle = <0x7e>;
					};

					l7 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						regulator-enable-ramp-delay = <0xfa>;
					};

					l8 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-system-load = <0x4f588>;
						regulator-allow-set-load;
						phandle = <0x50>;
					};

					l9 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x1cfde0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						phandle = <0x7d>;
					};

					l10 {
						regulator-min-microvolt = <0x1b2920>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						regulator-system-load = <0x36b0>;
						phandle = <0x45>;
					};

					l11 {
						regulator-min-microvolt = <0x1b2920>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-enable-ramp-delay = <0xfa>;
						phandle = <0x5f>;
					};

					l12 {
						regulator-min-microvolt = <0x1b2920>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-enable-ramp-delay = <0xfa>;
					};

					l13 {
						regulator-min-microvolt = <0x1b2920>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x80>;
					};

					l14 {
						regulator-min-microvolt = <0x1a17b0>;
						regulator-max-microvolt = <0x1cfde0>;
						regulator-enable-ramp-delay = <0xfa>;
						phandle = <0x73>;
					};

					l15 {
						regulator-min-microvolt = <0x192d50>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-enable-ramp-delay = <0xfa>;
					};

					l16 {
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-always-on;
					};

					l17 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x2d0b40>;
						regulator-enable-ramp-delay = <0xfa>;
					};

					l19 {
						regulator-min-microvolt = <0x328980>;
						regulator-max-microvolt = <0x33e140>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						phandle = <0x7f>;
					};
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wlan-msa-guard@85600000 {
			reg = <0x00 0x85600000 0x00 0x100000>;
			no-map;
		};

		wlan-msa-mem@85700000 {
			reg = <0x00 0x85700000 0x00 0x100000>;
			no-map;
			phandle = <0x95>;
		};

		qhee-code@85800000 {
			reg = <0x00 0x85800000 0x00 0x600000>;
			no-map;
		};

		memory@85e00000 {
