					};

					compute-cb@10 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x0a>;
						iommus = <0x9a 0x08>;
					};

					compute-cb@11 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x0b>;
						iommus = <0x9a 0x09>;
					};

					compute-cb@12 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x0c>;
						iommus = <0x9a 0x0a>;
					};

					compute-cb@13 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x0d>;
						iommus = <0x9a 0x0b>;
					};
				};
			};
		};
	};

	sound {
		compatible = "qcom,sdm660-internal-sndcard";
		model = "OPPO R11T";
		pinctrl-0 = <0x9b 0x9c 0x9d 0x9e>;
		pinctrl-names = "default";
		audio-routing = "RX_BIAS", "Digital MCLK", "INT_LDO_H", "Digital MCLK", "Digital RX_I2S_CLK", "Digital MCLK", "Digital TX_I2S_CLK", "Digital MCLK", "Digital ADC1", "ADC1", "Digital ADC2", "ADC2", "Digital ADC3", "ADC3", "PDM_RX1", "Digital PDM_RX1", "PDM_RX2", "Digital PDM_RX2", "PDM_RX3", "Digital PDM_RX3", "Digital LPASS_PDM_TX", "PDM_TX", "Headphone Jack", "HPH_L", "Headphone Jack", "HPH_R", "Headphone Jack", "HPL", "Headphone Jack", "HPR", "Speaker", "OUT", "AMIC1", "MIC BIAS External1", "AMIC2", "MIC BIAS External2", "Mic Jack", "MIC BIAS External2";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <0x9f 0x00>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <0x9f 0x01>;
			};
		};

		pri-mi2s-dai-link {
			link-name = "Primary MI2S Playback";

			cpu {
				sound-dai = <0xa0 0x10>;
			};

			platform {
				sound-dai = <0xa1>;
			};

			codec {
				sound-dai = <0xa2>;
			};
		};

		sec-mi2s-dai-link {
			link-name = "Secondary MI2S Playback";

			cpu {
				sound-dai = <0xa0 0x12>;
			};

			platform {
				sound-dai = <0xa1>;
			};

			codec {
				sound-dai = <0xa3>;
			};
		};

		int0-mi2s-dai-link {
			link-name = "Internal MI2S Playback";

			cpu {
				sound-dai = <0xa0 0x89>;
			};

			platform {
				sound-dai = <0xa1>;
			};

			codec {
				sound-dai = <0xa4 0x00 0xa5 0x00>;
			};
		};

		int3-mi2s-dai-link {
			link-name = "Internal MI2S Capture";

			cpu {
				sound-dai = <0xa0 0x90>;
			};

			platform {
				sound-dai = <0xa1>;
			};

			codec {
				sound-dai = <0xa4 0x01 0xa5 0x01>;
			};
		};
	};

	thermal-zones {

		aoss-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x00>;

			trips {

				trip-point0 {
					temperature = <0x19a28>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};
		};

		cpuss0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x01>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};
		};

		cpuss1-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x02>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};
		};

		cpu0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x03>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu1-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x04>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu2-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x05>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu3-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x06>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		pwr-cluster-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x07>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa6 0x08>;

			cooling-maps {

				map0 {
					trip = <0xa7>;
					cooling-device = <0xa8 0xffffffff 0xffffffff>;
				};
			};

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0xa7>;
				};

				trip-point1 {
					temperature = <0x15f90>;
					hysteresis = <0x3e8>;
					type = "hot";
				};

				trip-point2 {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		pm660-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa9>;

			trips {

				pm660-alert0 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				pm660-crit {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};

		pm660l-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xaa>;

			trips {

				pm660l-alert0 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				pm660l-crit {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0xf08 0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x00 0xf08>;
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x5e 0x1b0>;
		interrupts = <0x00 0x202 0x01>;
		mboxes = <0x1a 0x1e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x99>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x97>;
		};
	};

	battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <0x312220>;
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x426030>;
		constant-charge-current-max-microamp = <0x16e360>;
		phandle = <0x3c>;
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x1c>;
	};

	lcdb-regulator {
		compatible = "regulator-fixed";
		regulator-name = "lcdb";
		regulator-min-microvolt = <0x53ec60>;
		regulator-max-microvolt = <0x53ec60>;
		regulator-always-on;
		regulator-boot-on;
	};

	disp-vddts-regulator {
		compatible = "regulator-fixed";
		regulator-name = "disp_vddts_vreg";
		regulator-min-microvolt = <0x2ab980>;
		regulator-max-microvolt = <0x2ab980>;
		startup-delay-us = <0xfa0>;
		enable-active-high;
		regulator-boot-on;
		gpio = <0x28 0x49 0x00>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0xab>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <0x40 0x08 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <0x40 0x05 0x01>;
			linux,code = <0x72>;
			debounce-interval = <0x0f>;
			wakeup-source;
		};
	};

	extcon-usb {
		compatible = "linux,extcon-usb-gpio";
		id-gpios = <0x28 0x3a 0x00>;
	};

	regulator-touch-vdd {
		compatible = "regulator-fixed";
		regulator-name = "touchpanel_vdd";
		regulator-min-microvolt = <0x2ab980>;
		regulator-max-microvolt = <0x2ab980>;
		gpio = <0x28 0x0f 0x00>;
		enable-active-high;
		pinctrl-0 = <0xac>;
		pinctrl-names = "default";
		phandle = <0x72>;
	};

	memshare {
		compatible = "oppo,r11t-memshare";
	};
};
