			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack", "shutdown-ack";
			clocks = <0x25 0x40 0x25 0x18 0x25 0x2f 0x25 0x7c 0x25 0x44 0x25 0x42 0x26 0x08 0x26 0x00>;
