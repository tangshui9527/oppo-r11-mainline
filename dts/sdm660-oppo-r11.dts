/*
 * Device Tree for OPPO R11 (oppo16051)
 * Qualcomm Snapdragon 660 (SDM660)
 */

/dts-v1/;

#include "sdm660.dtsi"
#include "pm660.dtsi"
#include "pm660l.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>

/ {
	model = "OPPO R11";
	compatible = "oppo,r11", "qcom,sdm660-mtp", "qcom,sdm660";
	chassis-type = "handset";

	qcom,msm-id = <0x13d 0x0>;
	qcom,board-id = <0x8 0x0>;

	aliases {
		serial0 = &blsp1_uart2; /* Debug UART at 0xc170000 */
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";

		/* Pre-initialized stock framebuffer fallback */
		framebuffer0: framebuffer@9d400000 {
			compatible = "simple-framebuffer";
			reg = <0 0x9d400000 0 (1080 * 1920 * 4)>;
			width = <1080>;
			height = <1920>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			label = "Volume Up";
			gpios = <&pm660l_gpios 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <&pm660l_gpios 8 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <15>;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
	};
};

/* Early serial console */
&blsp1_uart2 {
	status = "okay";
};

/* Internal eMMC storage */
&sdhc_1 {
	status = "okay";
	supports-cqe;
	bus-width = <8>;
	non-removable;
};

/* MicroSD slot */
&sdhc_2 {
	status = "okay";
	bus-width = <4>;
};

/* USB 3.0 / 2.0 controller */
&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};
